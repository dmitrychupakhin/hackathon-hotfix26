# Upstream origin used only by Next.js rewrites (no /api suffix).
API_ORIGIN=https://company-corp.ru

# Server-only direct AI origin, needed when API_ORIGIN points directly to Django
# (without nginx). Without it, /ai is proxied through API_ORIGIN's nginx.
# AI_ORIGIN=http://127.0.0.1:8010

# Optional separate public WebSocket origin; the default same-origin /ai route
# now works through Next.js too. Include page origin in AI_ALLOWED_ORIGINS.
# NEXT_PUBLIC_AI_WS_ORIGIN=http://localhost
