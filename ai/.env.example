# Existing provider values are read from ../.env. Never commit a real key.
APIMIRA_API_KEY=
APIMIRA_BASE_URL=https://apimira.com/v1
APIMIRA_MODEL=openai/gpt-6-luna
AI_RATE_LIMIT_RETRIES=3
# Set only when the selected provider/model supports this parameter.
# APIMIRA_ENABLE_THINKING=false
AI_LLM_TIMEOUT_SECONDS=180
AI_LLM_MAX_OUTPUT_TOKENS=8000
AI_ENV=development
AI_DATABASE_URL=postgresql://ai_user:replace_me@db:5432/shared_database
AI_SOURCE_ROOT=data/incoming
AI_FILE_CACHE_ROOT=data/files
AI_FILE_IMPORT_TIMEOUT_SECONDS=300
AI_OCR_ENABLED=false
AI_CHUNK_TARGET_TOKENS=2000
AI_CHUNK_OVERLAP_TOKENS=200
# Docker host source folder mounted read-only as /source
AI_SOURCE_DIR=./incoming
# Required for production; only Django/backend holds this secret.
AI_SERVICE_KEY=
AI_ALLOWED_BASE_URLS=
AI_CONTEXT_WINDOW_TOKENS=266000
AI_MAX_CONTEXT_REDUCTIONS=5
AI_MAX_CONCURRENT_RUNS=2
AI_MAX_PENDING_RUNS=100
AI_RUN_TIMEOUT_SECONDS=1200
AI_MAX_MODEL_CALLS=48
AI_MAX_UPLOAD_BYTES=10485760
AI_MAX_PACKAGE_BYTES=33554432
AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional prices. Empty => cost unknown; no fabricated tariff.
# AI_INPUT_PRICE_PER_MILLION=...
# AI_OUTPUT_PRICE_PER_MILLION=...
# AI_CACHED_PRICE_PER_MILLION=...
AI_PRICE_CURRENCY=RUB
